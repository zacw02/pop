# ---- Database (Neon serverless Postgres) ----
# Create a project at https://neon.tech, copy the "Pooled" connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Email (Resend) ----
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sender. Until prostatecheckup.com is verified in Resend, use the
# built-in onboarding@resend.dev to test. After verifying the domain, switch to
# something like "POP Walk <walk@prostatecheckup.com>".
EMAIL_FROM="POP Walk <onboarding@resend.dev>"
# Where the org's copy of each registration + contact message is sent.
NOTIFY_EMAIL="pop@prostatecheckup.com"

# ---- PayPal ----
# From https://developer.paypal.com > Apps & Credentials.
# Use "sandbox" while testing, "live" when ready to take real money.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="xxxxxxxx"
PAYPAL_CLIENT_SECRET="xxxxxxxx"
# Public client id for the browser SDK. Usually the SAME value as PAYPAL_CLIENT_ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID="xxxxxxxx"
